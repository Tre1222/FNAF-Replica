# Godot 4+ specific ignores
.godot/
.import/

# Imported translations (auto-generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# System/tool-specific ignores
.directory
*~

# ============================================================
# Re-include rules — critical for `icon.svg.import`
# ============================================================
# Godot needs `icon.svg.import` to render the project icon. The broad
# `*.import` rule below would otherwise ignore it.
#
# IMPORTANT: negation patterns must NOT have a leading `/` — use `!foo`,
# NOT `!/foo`. The `/` form is silently broken by git's negation logic.
#
# `**/foo` (with **) re-includes the file at any depth, protecting against
# Godot's "Create on non-empty folder" bug (auto-slugified subfolder).
!icon.svg.import
!**/icon.svg.import
!icon.svg
!**/icon.svg
!project.godot
!**/project.godot

# Godot-specific ignores
*.cfg

# .import files for assets (auto-generated by Godot)
*.import

# Audio
*.sample
