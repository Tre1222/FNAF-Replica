# Godot 4+ specific ignores
.godot/
.import/

# Imported translations (auto-generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# System/tool-specific ignores
.directory
*~

# ============================================================
# Re-include rules (must come BEFORE the broad ignore rules below)
# ============================================================
# `**/icon.svg.import`, `**/project.godot`, `**/icon.svg` need to be re-allowed
# (the broad `*.import`, `*.cfg`, etc. patterns below would otherwise ignore them).
# `**/` is a "match at any depth" glob in gitignore (git 1.8+).
# We deliberately list each filename — `**/foo` re-includes every foo at any depth.
**/project.godot
**/icon.svg
**/icon.svg.import

# Godot-specific ignores
*.cfg

# .import files for assets (auto-generated by Godot)
*.import

# Audio
*.sample
